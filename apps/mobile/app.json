{
  "expo": {
    "name": "PitchOS",
    "slug": "pitchos",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pitchos",
    "userInterfaceStyle": "dark",
    "runtimeVersion": "1.0.1",
    "updates": {
      "url": "https://u.expo.dev/f1dea53f-665e-4d4b-8642-202cdc8e0c0b",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 8000,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pitchos.app",
      "appleTeamId": "Z2MD8HNCDK",
      "infoPlist": {
        "CFBundleDisplayName": "FounderVoice",
        "NSMicrophoneUsageDescription": "Allow FounderVoice to record pitch voice notes.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio"]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070708",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pitchos.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "pitchos",
              "host": "*",
              "pathPrefix": "/auth"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-dev-client",
      "expo-updates",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow FounderVoice to record pitch voice notes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366f1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f1dea53f-665e-4d4b-8642-202cdc8e0c0b"
      },
      "authRedirectPath": "auth/callback"
    },
    "owner": "coderanik"
  }
}
