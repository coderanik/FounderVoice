# Dev server port (avoid 8081, 3000–3002)
EXPO_DEV_SERVER_PORT=19006

# iOS Simulator / Expo web: http://127.0.0.1:8010/api
# Android Emulator:    http://10.0.2.2:8010/api
# Physical device:     http://<your-lan-ip>:8010/api
# Port 8000 is often taken by other local services; the phone uses the Metro host automatically.
# Production EAS builds: set EXPO_PUBLIC_API_BASE via `eas env:create`
EXPO_PUBLIC_API_BASE=http://127.0.0.1:8010/api

# Supabase Auth (Project Settings → API)
# Also push these to EAS for cloud builds — see EAS.md
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# OAuth redirect used by native builds (must be allowlisted in Supabase):
#   pitchos://auth/callback
